# Local development env — copy to .env.local and fill in.
# Deployed stages get these from SST secrets (sst secret set <Name> <value> --stage <stage>).

# Slack app credentials (from https://api.slack.com/apps → your dev app)
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=xoxb-...
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Workspace (team) id, e.g. T0123456789 — gates dashboard sign-in
SLACK_TEAM_ID=

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=

# Public base URL — Slack messages that link back to the dashboard (e.g. the
# rotation "Manage rotation" button) use this. No trailing slash.
SITE_URL=http://localhost:3000

# --- Database ---
# Option A (no AWS): DynamoDB Local — docker compose up -d && npm run db:local
TABLE_NAME=sprint-manager-local
AWS_ENDPOINT_URL_DYNAMODB=http://localhost:8000
AWS_REGION=local
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
# Option B (real AWS): TABLE_NAME from sst outputs; remove the endpoint/creds above.

# Treat any signed-in user as admin (development only; skips TEAM#SETTINGS)
DEV_ADMIN=true

# Dev-only sign-in bypass: your Slack member id (profile → ⋯ → Copy member ID).
# Gives the dashboard a synthetic admin session without Slack OAuth/tunnel.
# Ignored in production. Remove to test the real Sign in with Slack flow.
DEV_USER=
